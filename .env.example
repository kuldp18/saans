# Local live forecasts. Bind Next.js to the matching loopback host.
# For a hosted app use its exact HTTPS origin and configure the shared budget.
APP_ORIGIN=http://127.0.0.1:3000
AIR_LIVE_ENABLED=1
AIR_FORECAST_HOURS=16
AIR_TIMEOUT_MS=2500
AIR_UPSTREAM_PER_MINUTE=12
AIR_UPSTREAM_PER_DAY=500
AIR_BUDGET_NAMESPACE=

# Leave both blank for the free noncommercial endpoint.
# With a paid key the customer endpoint is selected automatically.
OPEN_METEO_AIR_URL=
OPEN_METEO_GEOCODING_URL=
OPEN_METEO_API_KEY=

# Published CPCB India AQI. A separate dated city reading, with no API key.
CPCB_BULLETIN_ENABLED=1
CPCB_BULLETIN_ARCHIVE_URL=https://cpcb.gov.in/AQI_Bulletin.php
CPCB_BULLETIN_TIMEOUT_MS=4500
CPCB_BULLETIN_MAX_AGE_HOURS=48

# Optional operator ranking. Keep off for the public deployment.
AI_MODE=off
AI_ELIGIBILITY_VERIFIED=0
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
AI_LOCAL_OPERATOR_TOKEN=
AI_ALLOWED_REGIONS=
AI_GATEWAY_SECRET=
AI_BUDGET_NAMESPACE=
AI_PROJECT_PER_MINUTE=
AI_PROJECT_PER_DAY=
AI_OPERATOR_PER_MINUTE=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
