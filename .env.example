# The Delhi sample needs no environment variables.
# Optional local development air provider. Bind the dev server to 127.0.0.1.
AIR_LIVE_ENABLED=0
# Set the exact public origin for hosted planner requests, e.g. https://saans.example.
APP_ORIGIN=
# Optional operator ranking. Keep off for the public deployment.
AI_MODE=off
AI_ELIGIBILITY_VERIFIED=0
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
AI_LOCAL_OPERATOR_TOKEN=
AI_ALLOWED_REGIONS=
AI_GATEWAY_SECRET=
AI_BUDGET_NAMESPACE=
AI_PROJECT_PER_MINUTE=
AI_PROJECT_PER_DAY=
AI_OPERATOR_PER_MINUTE=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
